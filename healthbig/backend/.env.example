# HealthBig Backend Environment Variables

# Database Configuration
# Default connects to PostgreSQL. If PostgreSQL is offline/unreachable,
# the system automatically and gracefully falls back to local SQLite (healthbig.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthbig_db

# Optional flag to force SQLite directly
USE_SQLITE=false

# Application Server
HOST=0.0.0.0
PORT=8000

# Telemetry Simulator Stream Interval (seconds)
SIMULATOR_INTERVAL_SECONDS=2.5

